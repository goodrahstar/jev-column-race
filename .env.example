# TypeSafe Jev (required for the left lane)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Comparison LLM (right lane): any OpenAI-compatible endpoint. Default: Gemini 3.8 Flash.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_LABEL=Gemini 3.8 Flash
# $ per million tokens (Gemini API paid tier, standard, through 2026-12-31; output includes thinking tokens)
LLM_PRICE_INPUT=0.75
LLM_PRICE_OUTPUT=3.75
# Thinking off: Gemini's fastest and cheapest setting (3.8 Flash rejects "minimal")
LLM_EXTRA_BODY={"reasoning_effort":"none"}

# Same for both lanes, so the race is fair
BATCH_SIZE=20
CONCURRENCY=8
PORT=8777
